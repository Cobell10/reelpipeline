# Reel Pipeline — Environment Variables
# Copy this file to .env and fill in your keys

# Groq API key — used for Whisper transcription (free tier)
GROQ_API_KEY=gsk_...

# Anthropic API key — used for Claude Haiku summarization
ANTHROPIC_API_KEY=sk-ant-...

# Obsidian Local REST API
# Get this from Obsidian → Settings → Local REST API → Copy API Key
OBSIDIAN_API_KEY=your-obsidian-key-here
OBSIDIAN_HOST=http://localhost:27123

# GitHub queue repo — set these on Render; leave unset for local mode
GITHUB_TOKEN=ghp_...
GITHUB_QUEUE_REPO=cobell2429/reelpipeline-queue

# Render URL — used by flush.py on your PC to reach the cloud server
RENDER_URL=https://your-app.onrender.com

# Server port (default is fine for local)
PORT=8765
